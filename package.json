{
  "name": "@gitmiro/ts-appversion",
  "version": "1.1.0",
  "description": "Reads version information from your package.json and Git and writes it to a TypeScript file you can import in your application.",
  "keywords": [
    "angular",
    "typescript",
    "git",
    "version",
    "versioning",
    "build-info"
  ],
  "homepage": "https://github.com/gitmiro/ts-appversion#readme",
  "bugs": {
    "url": "https://github.com/gitmiro/ts-appversion/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitmiro/ts-appversion.git"
  },
  "license": "MIT",
  "author": "Mirolub Zlatkovic",
  "contributors": [
    "Mario Lubenka (original author of saitho/ts-appversion)"
  ],
  "main": "src/index.js",
  "bin": {
    "ts-appversion": "src/cli.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "preversion": "npm test"
  },
  "dependencies": {
    "picocolors": "^1.1.1"
  }
}
